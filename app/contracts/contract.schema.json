{
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "0.3.0-draft.1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_schema": {
      "$ref": "#/$defs/schemaNode"
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "projection": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "output_schema": {
            "$ref": "#/$defs/schemaNode"
          },
          "processors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "processor_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "type": {
                  "const": "presidio_redact"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "minItems": 1,
                  "maxItems": 256,
                  "uniqueItems": true
                },
                "language": {
                  "const": "en"
                },
                "entities": {
                  "const": [
                    "EMAIL_ADDRESS"
                  ]
                },
                "replacement": {
                  "const": "[EMAIL]"
                },
                "required": {
                  "const": true
                }
              },
              "required": [
                "processor_id",
                "type",
                "paths",
                "language",
                "entities",
                "replacement",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "view_id",
          "display_name",
          "purpose",
          "projection",
          "output_schema",
          "processors"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "view_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "principal": {
            "type": "object",
            "properties": {
              "agent_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              },
              "organization_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "policy_id",
          "effect",
          "view_ids",
          "principal"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "delivery": {
      "type": "object",
      "properties": {
        "failure_mode": {
          "const": "closed"
        },
        "audit_required": {
          "const": true
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "total_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "failure_mode",
        "audit_required",
        "max_response_bytes",
        "total_timeout_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec_version",
    "contract_id",
    "contract_version",
    "source_schema",
    "views",
    "policies",
    "delivery"
  ],
  "additionalProperties": false,
  "$defs": {
    "schemaNode": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schemaNode"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/schemaNode"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "const": {},
        "pattern": {
          "enum": [
            "^meeting-[0-9]{3}$",
            "^item-[0-9]{3}$"
          ]
        },
        "format": {
          "enum": [
            "email",
            "date"
          ]
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
